{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Post",
  "description": "A post resource in the API",
  "type": "object",
  "required": ["title", "body"],
  "properties": {
    "id": {
      "type": "integer",
      "description": "The unique identifier for a post"
    },
    "user_id": {
      "type": "integer",
      "description": "The user ID associated with the post"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "The title of the post"
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "description": "The content of the post"
    }
  }
} 